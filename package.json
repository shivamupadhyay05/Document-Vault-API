{
  "name": "document-vault-api",
  "version": "1.0.0",
  "description": "Document Vault - GraphQL API",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "gendb": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "prisma": "^6.4.0",
    "typescript": "^5.7.0"
  }
}
